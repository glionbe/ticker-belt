{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ticker Belt",
  "version": "0.5.0",
  "identifier": "com.lionberger.tickerbelt",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ticker Belt",
        "width": 900,
        "height": 56,
        "minWidth": 320,
        "minHeight": 44,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://finnhub.io https://api.twelvedata.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "George Lionberger",
    "shortDescription": "A scrolling stock ticker for your desktop",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3RjY5MjRBQkIzRkRDM0QKUldROTNEKzdTcEwySjd5aGRpRXFKbjhYWnF6OERzZjVBUVpiZW1QSjc5ZUM3VWJvWmNiaEpuRmQK",
      "endpoints": [
        "https://github.com/glionbe/ticker-belt/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
